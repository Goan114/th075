static GameProfile presentationProfile;static ResultScene resultFixture;static ResultListScene resultListFixture;static NameEntryScene nameFixture;static ReplayBrowserScene replayBrowserFixture;static SceneFade sceneFadeFixture;
static void presentation_progress(const u8* p){auto& v=presentationProfile.characters[0].difficulty[0];for(u32 i=0;i<4;i++)v.counters[i]=fixture_read<u32>(p,i*4);for(u32 i=0;i<150;i++){v.cards[i].highestScore=fixture_read<u32>(p,16+i*4);v.cards[i].captures=fixture_read<u16>(p,0x268+i*2);v.cards[i].attempts=fixture_read<u16>(p,0x394+i*2);v.cards[i].perfect=p[0x4c0+i];}for(u32 i=0;i<10;i++){std::copy_n(p+0x55c+i*16,8,v.ranking[i].name.data());v.ranking[i].month=p[0x564+i*16];v.ranking[i].day=p[0x565+i*16];v.ranking[i].score=fixture_read<u32>(p,0x568+i*16);}}
API(presentation_draw) void presentation_draw(u32 op,const u8* p,const u8* data,u32 now){backgroundCapture.draws.clear();switch(op){case 0:{FighterActor f;f.score=i32(now);resultFixture.backgroundScale=fixture_read<float>(p,20);resultFixture.alpha=p[24];resultFixture.base=fixture_read<i32>(p,28);resultFixture.combo=fixture_read<i32>(p,32);resultFixture.capture=fixture_read<i32>(p,36);resultFixture.lives=fixture_read<i32>(p,40);resultFixture.pending=fixture_read<i32>(p,56);for(u32 i=0;i<5;i++)resultFixture.slide[i]=fixture_read<i16>(p,66+i*2);resultFixture.render(backgroundImages,511,f,data[0]);break;}case 1:{presentation_progress(data);resultListFixture.page=fixture_read<i16>(p,0x1bc);resultListFixture.character=resultListFixture.difficulty=0;resultListFixture.cardsMode=p[0x1c5]!=0;resultListFixture.render(backgroundImages,512,presentationProfile,now);break;}case 2:{presentation_progress(data);nameFixture.column=fixture_read<i16>(p,0x10);nameFixture.row=fixture_read<i16>(p,0x12);nameFixture.position=fixture_read<i16>(p,0x14);nameFixture.rank=p[0x120];nameFixture.render_score(backgroundImages,presentationProfile.characters[0].difficulty[0].ranking,now);break;}case 3:{ReplayFile file;std::copy_n(data,60,file.header.data());nameFixture.column=fixture_read<i16>(p,14);nameFixture.row=fixture_read<i16>(p,16);nameFixture.position=fixture_read<i16>(p,18);nameFixture.yesNo=fixture_read<i16>(p,20);nameFixture.skip=p[22]!=0;nameFixture.render_replay(backgroundImages,file,"replay/replay123.rep",data[60],now);break;}case 4:{sceneFadeFixture.count=fixture_read<i32>(p,0);sceneFadeFixture.style=fixture_read<u16>(p,4);sceneFadeFixture.render(backgroundImages,511);break;}case 5:{replayBrowserFixture.entries.resize(now);for(u32 i=0;i<now;i++){auto& e=replayBrowserFixture.entries[i];e.filename="replay/replay123.rep";std::copy_n(data+i*61,60,e.replay.header.data());e.otherCharacter=data[i*61+60];}replayBrowserFixture.selected=fixture_read<i16>(p,0x48);replayBrowserFixture.round=fixture_read<i16>(p,0x4a);replayBrowserFixture.alpha=p[0x4c];replayBrowserFixture.roundSelection=p[0x51];replayBrowserFixture.render(backgroundImages);break;}}}

static FighterActor resultActor,resultOther;static RoundRules resultRules;static BattleSession resultSession;
struct ResultSignalCapture:ResultSignals {std::vector<i32> events;void sound(u16 n)override{events.insert(events.end(),{1,n});}void fade_music(i32 a,i32 b,u32 c,u32 d)override{events.insert(events.end(),{4,a,b,i32(c),i32(d)});}void render_result()override{events.push_back(2);}void present_result()override{events.push_back(3);}void select_music(i16 n)override{events.insert(events.end(),{5,n});}};static ResultSignalCapture resultSignals;
API(result_initialize) void result_initialize(const i32* v){resultActor={};resultOther={};resultRules={};resultSession={};resultActor.combat.health=i16(v[0]);resultActor.combat.spellPhase=u8(v[1]);resultRules.remainingLives=i8(v[2]);resultRules.awardedSpellTime=v[3];resultSession.maximumStoryBonus=v[4];resultOther.stageClearBonus=v[5];resultActor.score=v[6];resultFixture.initialize(resultActor,resultOther,resultRules,resultSession,i16(v[7]));resultSignals.events.clear();}
API(result_state) const u8* result_state(){static std::array<u8,80> b{};const auto put=[&](u32 at,const auto& v){std::memcpy(b.data()+at,&v,sizeof(v));};put(16,resultFixture.payoutStep);put(20,resultFixture.backgroundScale);b[24]=resultFixture.alpha;b[25]=resultFixture.soundCycle;put(28,resultFixture.base);put(32,resultFixture.combo);put(36,resultFixture.capture);put(40,resultFixture.lives);put(44,resultFixture.comboMultiplier);put(48,resultFixture.captureMultiplier);put(52,resultFixture.lifeMultiplier);put(56,resultFixture.pending);put(60,resultFixture.timer);b[64]=resultFixture.phase;for(u32 i=0;i<5;i++)put(66+i*2,resultFixture.slide[i]);return b.data();}
API(result_advance) u32 result_advance(u32 confirm,u32 difficulty,u32 stage,u32 mode,u32 count,u32 round,u32 continued){resultSignals.events.clear();resultSession.replayMode=u8(mode);resultSession.roundIndex=i8(round);resultSession.continued=continued;return resultFixture.advance(confirm,resultActor,resultRules,resultSession,u8(difficulty),u8(stage),u8(count),resultSignals,continued!=0);}
API(result_globals) const i32* result_globals(){static std::array<i32,4> b;b={resultActor.score,i32(resultRules.highScore),resultSession.replayDisposition,resultActor.combat.health};return b.data();}
API(result_events) const i32* result_events(){return resultSignals.events.data();}API(result_event_count) u32 result_event_count(){return resultSignals.events.size();}

struct NameSignalCapture:NameEntrySignals {std::vector<i32> events;void fade_music(i32,i32,u32,u32)override{}void sound(u16 n)override{events.insert(events.end(),{1,n});}void render_name_entry()override{events.push_back(2);}void present_name_entry()override{events.push_back(3);}void save_score_name(u8 n)override{events.insert(events.end(),{5,n});}void save_replay_name()override{events.push_back(4);}};static NameSignalCapture nameSignals;static std::array<u8,8> nameBytes;
API(name_state_load) void name_state_load(u32 replay,const i32* v,const u8* name){nameFixture.replay=replay;nameFixture.column=i16(v[0]);nameFixture.row=i16(v[1]);nameFixture.position=i16(v[2]);nameFixture.yesNo=i16(v[3]);nameFixture.action=i16(v[4]);nameFixture.skip=v[5];nameFixture.rank=u8(v[6]);std::copy_n(name,8,nameBytes.data());nameSignals.events.clear();}
API(name_advance) u32 name_advance(const i32* v,u32 recording,i32 disposition){MenuInput input;std::array<i32,2> quick;for(u8 s=0;s<2;s++){input.horizontal[s]=v[s*5];input.vertical[s]=v[s*5+1];input.confirm[s]=v[s*5+2];input.cancel[s]=v[s*5+3];quick[s]=v[s*5+4];}nameSignals.events.clear();nameFixture.poll(input,quick,nameSignals);return nameFixture.advance(nameBytes,recording,i8(disposition),nameSignals);}
API(name_state) const i32* name_state(){static std::array<i32,7> v;v={nameFixture.column,nameFixture.row,nameFixture.position,nameFixture.yesNo,nameFixture.action,i32(nameFixture.skip),nameFixture.rank};return v.data();}API(name_bytes) const u8* name_bytes(){return nameBytes.data();}API(name_events) const i32* name_events(){return nameSignals.events.data();}API(name_event_count) u32 name_event_count(){return nameSignals.events.size();}
