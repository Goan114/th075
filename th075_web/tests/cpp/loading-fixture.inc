#include "../../cpp/game/BattleLoading.hpp"
#include "../../cpp/game/ReplayConfiguration.hpp"
static std::unique_ptr<CharacterController> factoryCharacter;
API(factory_create) u32 factory_create(u32 id){factoryCharacter=create_character(u8(id));return factoryCharacter!=nullptr;}
API(factory_name) const char* factory_name(){return factoryCharacter->name();}
API(factory_metadata) const u32* factory_metadata(){static std::array<u32,13> v;const auto& a=*factoryCharacter;v={a.spellPortraitImage,u32(u8(a.actor.portraitMaximum)),u32(a.next_story_stage())};for(u32 i=0;i<10;i++)v[3+i]=a.victoryRoutes[i];return v.data();}
API(factory_story_opponent) u32 factory_story_opponent(u32 stage){factoryCharacter->prepare_story(u8(stage));return factoryCharacter->story_opponent();}
API(factory_background) i32 factory_background(u32 index,u32 animated){BackgroundKind result;return choose_background(u8(index),animated!=0,result)?i32(result):-1;}
static GameSelection arcadeSelection;static ArcadeRoute arcadeRoute;static SelectionUnlocks arcadeUnlocks;static ReplayRandom arcadeRandom;
API(arcade_begin) void arcade_begin(const u8* flags,u32 player,u32 palette,u32 seed){arcadeSelection={};arcadeSelection.character[0]=player;arcadeSelection.alternatePalette[0]=palette;arcadeRoute={};std::memcpy(arcadeUnlocks.storyFlags.data(),flags,256);arcadeRandom.state=seed;}
API(arcade_advance) void arcade_advance(){arcadeRoute.advance(arcadeSelection,arcadeUnlocks,arcadeRandom);}
API(arcade_state) const u32* arcade_state(){static std::array<u32,17> v;v={arcadeSelection.storyStage,arcadeRoute.available,arcadeSelection.character[1],arcadeSelection.background,arcadeSelection.alternatePalette[1],arcadeSelection.firstSpell[1],arcadeSelection.secondSpell[1]};for(u32 i=0;i<10;i++)v[7+i]=arcadeRoute.opponents[i];return v.data();}
API(arcade_rng) u32 arcade_rng(){return arcadeRandom.state;}
static ReplayFile replayConfigFile;static GameSelection replayConfigSelection;static SelectionSettings replayConfigSettings;static RoundRules replayConfigRules;static FighterActor replayConfigActor;static ReplayStreams replayConfigStreams;
API(replay_config_begin) void replay_config_begin(const u8* h,const u8* meta){std::memcpy(replayConfigFile.header.data(),h,60);replayConfigFile.rounds.resize(1);auto& r=replayConfigFile.rounds[0];std::memcpy(r.opponentOptions.data(),meta,6);r.stage=meta[6];r.initialHealth=fixture_read<i16>(meta,7);r.initialLives=meta[9];r.initialScore=fixture_read<u32>(meta,10);replayConfigSelection={};replayConfigSettings={};replayConfigRules={};}
API(replay_config_load) u32 replay_config_load(){return ReplayConfiguration::load(replayConfigFile,0,replayConfigSelection,replayConfigSettings,replayConfigRules,replayConfigStreams);}
API(replay_config_state) const u8* replay_config_state(){static std::array<u8,18> v;const auto& s=replayConfigSelection;v={u8(s.mode),s.activePlayer,s.difficulty,s.character[0],s.character[1],s.firstSpell[0],s.firstSpell[1],s.secondSpell[0],s.secondSpell[1],s.alternatePalette[0],s.alternatePalette[1],replayConfigSettings.easyCommands[0],replayConfigSettings.easyCommands[1],replayConfigSettings.handicap[0],replayConfigSettings.handicap[1],s.background,s.storyStage,u8(replayConfigRules.remainingLives)};return v.data();}
API(replay_config_record) void replay_config_record(const u8* v,u32 score,i32 health,u32 lives){auto& s=replayConfigSelection;s.mode=GameMode(v[0]);s.activePlayer=v[1];s.difficulty=v[2];s.character={v[3],v[4]};s.firstSpell={v[5],v[6]};s.secondSpell={v[7],v[8]};s.alternatePalette={v[9],v[10]};replayConfigSettings.easyCommands={v[11],v[12]};replayConfigSettings.handicap={v[13],v[14]};s.background=v[15];s.storyStage=v[16];replayConfigActor.score=i32(score);replayConfigActor.combat.health=i16(health);replayConfigRules.remainingLives=i8(lives);ReplayConfiguration::record(replayConfigFile,replayConfigFile.rounds[0],s,replayConfigSettings,replayConfigRules,replayConfigActor);}
API(replay_config_header) const u8* replay_config_header(){return replayConfigFile.header.data();}
API(replay_config_round) const u8* replay_config_round(){static std::array<u8,14> v;const auto& r=replayConfigFile.rounds[0];std::memcpy(v.data(),r.opponentOptions.data(),6);v[6]=r.stage;std::memcpy(v.data()+7,&r.initialHealth,2);v[9]=r.initialLives;std::memcpy(v.data()+10,&r.initialScore,4);return v.data();}
